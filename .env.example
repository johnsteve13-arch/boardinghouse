# ===================================================================
# SEAIT Stay Environment Configuration
# ===================================================================

# Server API Configuration (apps/api)
PORT=4000
NODE_ENV=development
JWT_SECRET=seait-stay-super-secret-jwt-key-2024
CORS_ORIGIN=http://localhost:3000

# PostgreSQL / Supabase Database
# (If omitted, the API runs seamlessly in in-memory mode initialized with SEAIT seed data)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Frontend Web Configuration (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Optional Mapbox token (OSM / Leaflet tiles are configured by default out-of-the-box)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
